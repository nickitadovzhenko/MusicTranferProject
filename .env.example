# Copy this file to .env and fill in your values.
# DB_HOST=db is for Docker. On Railway/Render, use the platform-provided host.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL)
DB_NAME=streamify
DB_USER=streamify_user
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-db-root-password
DB_HOST=db
DB_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Spotify OAuth — create an app at developer.spotify.com
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://your-domain.com/api/spotify_callback

# Google / YouTube OAuth — create credentials at console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/youtube_callback

# Email (for account verification)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
